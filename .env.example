# App
NODE_ENV=development
APP_NAME=Bey360
APP_URL=http://localhost:3000
APP_SECRET=change-me-with-64-random-chars
DEFAULT_TENANT_SLUG=demo-market
DEFAULT_LOCALE=tr-TR
DEFAULT_TIMEZONE=Europe/Istanbul

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muhasebe?schema=public
DATABASE_TARGET=auto
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/muhasebe_local?schema=public
CLOUD_DATABASE_URL=postgresql://neondb_owner:password@your-neon-pooler-host/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
NEON_DATABASE_URL=
# DIRECT_URL migration icin tercih edilir. Bos birakilirsa build scripti DATABASE_URL'den turetmeye calisir.
DIRECT_URL=
CLOUD_STATUS_URL=https://bey360.com/api/health

# Redis / Queue
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=muhasebe

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=muhasebe-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Payment Webhook Secrets (sample)
PAYMENT_WEBHOOK_SIGNING_KEY=replace-me-with-secure-key
EINVOICE_WEBHOOK_SIGNING_KEY=replace-me-with-secure-key

# Security
SESSION_TTL_MINUTES=720
REFRESH_TTL_DAYS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
SUPPORT_IMPERSONATION_ENABLED=false

# Backup
BACKUP_DIR=.backups
BACKUP_MAX_ROWS=5000

