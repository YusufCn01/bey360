{
  "name": "muhasebe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3015",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:start": "npm --prefix apps/desktop run start",
    "desktop:start:cloud": "npm --prefix apps/desktop run start:cloud",
    "desktop:start:local": "npm --prefix apps/desktop run start:local",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build:win": "npm --prefix apps/desktop run build:win",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:web": "npm --prefix apps/mobile run web",
    "build": "node scripts/build-app.mjs",
    "build:prod": "node scripts/build-prod.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:prepare": "npm run deploy:check && npm run prisma:generate && npm run prisma:migrate:deploy && npm run build",
    "backup:daily": "node scripts/backup-daily.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker/index.ts",
    "prisma:generate": "node scripts/prisma-run.mjs generate",
    "prisma:migrate": "node scripts/prisma-run.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-run.mjs migrate deploy",
    "db:seed": "node scripts/prisma-run.mjs db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.0",
    "jspdf": "^4.2.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
