generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INVITED
  LOCKED
  DISABLED
}

enum RoleScope {
  TENANT
  BRANCH
  WAREHOUSE
  REGISTER
}

enum SeverityLevel {
  INFO
  WARNING
  CRITICAL
}

model Tenant {
  id                         String                       @id @default(cuid())
  slug                       String                       @unique @db.VarChar(80)
  legalName                  String                       @db.VarChar(255)
  tradeName                  String?                      @db.VarChar(255)
  taxNumber                  String                       @unique @db.VarChar(20)
  mersisNumber               String?                      @db.VarChar(20)
  locale                     String                       @default("tr-TR") @db.VarChar(10)
  timezone                   String                       @default("Europe/Istanbul") @db.VarChar(100)
  currency                   String                       @default("TRY") @db.VarChar(3)
  status                     TenantStatus                 @default(TRIALING)
  trialEndsAt                DateTime?
  activeUntil                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  users                      User[]
  roles                      Role[]
  sessions                   Session[]
  refreshTokens              RefreshToken[]
  modules                    TenantModule[]
  entitlements               TenantModuleEntitlement[]
  usageCounters              TenantUsageCounter[]
  apiKeys                    TenantApiKey[]
  webhooks                   TenantWebhook[]
  auditLogs                  AuditLog[]
  TenantWebhookDelivery      TenantWebhookDelivery[]
  TenantDomains              TenantDomains[]
  TenantBrands               TenantBrands[]
  TenantStatusHistory        TenantStatusHistory[]
  TenantSettings             TenantSettings[]
  TenantLocales              TenantLocales[]
  TenantTimezones            TenantTimezones[]
  TenantFeatureFlags         TenantFeatureFlags[]
  TenantSubscriptions        TenantSubscriptions[]
  SubscriptionItems          SubscriptionItems[]
  SubscriptionUsageRecords   SubscriptionUsageRecords[]
  BillingCustomers           BillingCustomers[]
  BillingAddresses           BillingAddresses[]
  BillingInvoices            BillingInvoices[]
  BillingInvoiceItems        BillingInvoiceItems[]
  BillingPayments            BillingPayments[]
  BillingRefunds             BillingRefunds[]
  BillingCreditNotes         BillingCreditNotes[]
  TrialPeriods               TrialPeriods[]
  CouponDefinitions          CouponDefinitions[]
  CouponRedemptions          CouponRedemptions[]
  UserProfiles               UserProfiles[]
  UserEmails                 UserEmails[]
  UserPhones                 UserPhones[]
  UserPasswords              UserPasswords[]
  PasswordResetTokens        PasswordResetTokens[]
  EmailVerificationTokens    EmailVerificationTokens[]
  MfaMethods                 MfaMethods[]
  MfaRecoveryCodes           MfaRecoveryCodes[]
  LoginAttempts              LoginAttempts[]
  DeviceSessions             DeviceSessions[]
  IpAccessLogs               IpAccessLogs[]
  UserInvitations            UserInvitations[]
  UserPermissionOverrides    UserPermissionOverrides[]
  Branches                   Branches[]
  BranchUsers                BranchUsers[]
  Warehouses                 Warehouses[]
  WarehouseUsers             WarehouseUsers[]
  CashRegisters              CashRegisters[]
  RegisterUsers              RegisterUsers[]
  Departments                Departments[]
  Teams                      Teams[]
  SalesReps                  SalesReps[]
  Products                   Products[]
  ProductTypes               ProductTypes[]
  ProductStatuses            ProductStatuses[]
  ProductGroups              ProductGroups[]
  ProductSubgroups           ProductSubgroups[]
  Brands                     Brands[]
  Units                      Units[]
  UnitConversions            UnitConversions[]
  ProductBarcodes            ProductBarcodes[]
  ProductQrcodes             ProductQrcodes[]
  ProductImages              ProductImages[]
  ProductFiles               ProductFiles[]
  ProductTags                ProductTags[]
  ProductTagRelations        ProductTagRelations[]
  ProductAttributes          ProductAttributes[]
  ProductAttributeValues     ProductAttributeValues[]
  ProductVariants            ProductVariants[]
  ProductVariantValues       ProductVariantValues[]
  ProductSerialProfiles      ProductSerialProfiles[]
  ProductLotProfiles         ProductLotProfiles[]
  ProductShelfLocations      ProductShelfLocations[]
  ProductNotes               ProductNotes[]
  ProductLocks               ProductLocks[]
  PriceLists                 PriceLists[]
  PriceListItems             PriceListItems[]
  ProductPrices              ProductPrices[]
  CustomerSpecificPrices     CustomerSpecificPrices[]
  SupplierSpecificPrices     SupplierSpecificPrices[]
  BulkPricingRules           BulkPricingRules[]
  DiscountRules              DiscountRules[]
  PromotionRules             PromotionRules[]
  CampaignRules              CampaignRules[]
  ExchangeRates              ExchangeRates[]
  StockBalances              StockBalances[]
  StockMovements             StockMovements[]
  InventoryDocuments         InventoryDocuments[]
  InventoryDocumentItems     InventoryDocumentItems[]
  StockCounts                StockCounts[]
  StockCountItems            StockCountItems[]
  StockAdjustments           StockAdjustments[]
  StockTransfers             StockTransfers[]
  StockTransferItems         StockTransferItems[]
  LotBatches                 LotBatches[]
  SerialNumbers              SerialNumbers[]
  InventoryReservations      InventoryReservations[]
  ReorderRules               ReorderRules[]
  ExpiryTrackingRecords      ExpiryTrackingRecords[]
  Customers                  Customers[]
  CustomerGroups             CustomerGroups[]
  CustomerSubgroups          CustomerSubgroups[]
  CustomerAddresses          CustomerAddresses[]
  CustomerContacts           CustomerContacts[]
  CustomerNotes              CustomerNotes[]
  CustomerLimits             CustomerLimits[]
  CustomerRiskProfiles       CustomerRiskProfiles[]
  CustomerBalances           CustomerBalances[]
  CustomerStatements         CustomerStatements[]
  CustomerDocuments          CustomerDocuments[]
  CustomerTags               CustomerTags[]
  Suppliers                  Suppliers[]
  SupplierGroups             SupplierGroups[]
  SupplierSubgroups          SupplierSubgroups[]
  SupplierAddresses          SupplierAddresses[]
  SupplierContacts           SupplierContacts[]
  SupplierNotes              SupplierNotes[]
  SupplierLimits             SupplierLimits[]
  SupplierBalances           SupplierBalances[]
  SupplierStatements         SupplierStatements[]
  SupplierDocuments          SupplierDocuments[]
  SupplierTags               SupplierTags[]
  CurrentAccounts            CurrentAccounts[]
  CurrentAccountTypes        CurrentAccountTypes[]
  CurrentAccountMovements    CurrentAccountMovements[]
  BalanceSnapshots           BalanceSnapshots[]
  DueSchedules               DueSchedules[]
  Collections                Collections[]
  CollectionItems            CollectionItems[]
  PaymentsOut                PaymentsOut[]
  PaymentOutItems            PaymentOutItems[]
  Sales                      Sales[]
  SaleItems                  SaleItems[]
  SaleItemTaxes              SaleItemTaxes[]
  SaleItemDiscounts          SaleItemDiscounts[]
  SalePayments               SalePayments[]
  SaleRegisterSessions       SaleRegisterSessions[]
  SuspendedSales             SuspendedSales[]
  SuspendedSaleItems         SuspendedSaleItems[]
  SaleReceipts               SaleReceipts[]
  ReceiptTemplates           ReceiptTemplates[]
  CartEvents                 CartEvents[]
  PriceCheckLogs             PriceCheckLogs[]
  PromoSaleRecords           PromoSaleRecords[]
  SalesReturns               SalesReturns[]
  SalesReturnItems           SalesReturnItems[]
  RefundTransactions         RefundTransactions[]
  CancellationRecords        CancellationRecords[]
  CancelledCartItems         CancelledCartItems[]
  VoidedSales                VoidedSales[]
  PurchaseOrders             PurchaseOrders[]
  PurchaseOrderItems         PurchaseOrderItems[]
  GoodsReceipts              GoodsReceipts[]
  GoodsReceiptItems          GoodsReceiptItems[]
  PurchaseInvoices           PurchaseInvoices[]
  PurchaseInvoiceItems       PurchaseInvoiceItems[]
  PurchaseCostAllocations    PurchaseCostAllocations[]
  SupplierReturnNotes        SupplierReturnNotes[]
  SupplierReturnItems        SupplierReturnItems[]
  Invoices                   Invoices[]
  InvoiceItems               InvoiceItems[]
  DispatchNotes              DispatchNotes[]
  DispatchNoteItems          DispatchNoteItems[]
  InvoiceSequences           InvoiceSequences[]
  DocumentNumberSeries       DocumentNumberSeries[]
  PrintTemplates             PrintTemplates[]
  DocumentAttachments        DocumentAttachments[]
  CashAccounts               CashAccounts[]
  CashTransactions           CashTransactions[]
  DailyCashClosings          DailyCashClosings[]
  CashOpeningRecords         CashOpeningRecords[]
  CashTransferRecords        CashTransferRecords[]
  BankAccounts               BankAccounts[]
  BankTransactions           BankTransactions[]
  BankReconciliations        BankReconciliations[]
  BankPosDevices             BankPosDevices[]
  BankVirtualPosProfiles     BankVirtualPosProfiles[]
  ExpenseGroups              ExpenseGroups[]
  Expenses                   Expenses[]
  ExpenseDocuments           ExpenseDocuments[]
  RecurringExpenses          RecurringExpenses[]
  PaymentProviderConfigs     PaymentProviderConfigs[]
  PaymentCustomers           PaymentCustomers[]
  PaymentLinks               PaymentLinks[]
  PaymentLinkEvents          PaymentLinkEvents[]
  PaymentTransactions        PaymentTransactions[]
  PaymentTransactionAttempts PaymentTransactionAttempts[]
  PaymentRefunds             PaymentRefunds[]
  PaymentWebhookLogs         PaymentWebhookLogs[]
  PayoutRecords              PayoutRecords[]
  EInvoiceProviderConfigs    EInvoiceProviderConfigs[]
  EInvoiceSenderUnits        EInvoiceSenderUnits[]
  EInvoiceReceivers          EInvoiceReceivers[]
  EInvoiceDocuments          EInvoiceDocuments[]
  EInvoiceDocumentItems      EInvoiceDocumentItems[]
  EInvoiceXmlArchives        EInvoiceXmlArchives[]
  EInvoiceStatusLogs         EInvoiceStatusLogs[]
  EInvoiceSendAttempts       EInvoiceSendAttempts[]
  EInvoiceWebhookLogs        EInvoiceWebhookLogs[]
  EArchiveDocuments          EArchiveDocuments[]
  GibAliasRecords            GibAliasRecords[]
  OutboundDocumentQueues     OutboundDocumentQueues[]
  InboundDocumentRecords     InboundDocumentRecords[]
  Files                      Files[]
  FileFolders                FileFolders[]
  FileAccessLogs             FileAccessLogs[]
  DocumentTags               DocumentTags[]
  DocumentRelations          DocumentRelations[]
  Notifications              Notifications[]
  NotificationTemplates      NotificationTemplates[]
  NotificationDeliveries     NotificationDeliveries[]
  EmailLogs                  EmailLogs[]
  SmsLogs                    SmsLogs[]
  InAppNotifications         InAppNotifications[]
  AuditLogItems              AuditLogItems[]
  SecurityEvents             SecurityEvents[]
  AccessPolicies             AccessPolicies[]
  ApiAccessLogs              ApiAccessLogs[]
  SuspiciousActivityLogs     SuspiciousActivityLogs[]
  DataExportLogs             DataExportLogs[]
  DataDeletionLogs           DataDeletionLogs[]
  BranchSettings             BranchSettings[]
  PosSettings                PosSettings[]
  InvoiceSettings            InvoiceSettings[]
  EInvoiceSettings           EInvoiceSettings[]
  PaymentSettings            PaymentSettings[]
  ReportSettings             ReportSettings[]
  PrinterSettings            PrinterSettings[]
  UiSettings                 UiSettings[]
  ApprovalFlows              ApprovalFlows[]
  ApprovalSteps              ApprovalSteps[]
  ApprovalRequests           ApprovalRequests[]
  ApprovalRequestItems       ApprovalRequestItems[]
  WorkflowEvents             WorkflowEvents[]
  DashboardSnapshots         DashboardSnapshots[]
  ReportRuns                 ReportRuns[]
  KpiSnapshots               KpiSnapshots[]
  DailySalesAggregates       DailySalesAggregates[]
  MonthlySalesAggregates     MonthlySalesAggregates[]
  StockValuationSnapshots    StockValuationSnapshots[]
  JobRuns                    JobRuns[]
  QueueFailures              QueueFailures[]
  IntegrationLogs            IntegrationLogs[]
  ExternalSyncStates         ExternalSyncStates[]
  WebhookRetries             WebhookRetries[]
  SupportTickets             SupportTickets[]
  SupportTicketMessages      SupportTicketMessages[]
  SupportSessions            SupportSessions[]

  @@map("tenants")
}

model PlatformUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  fullName     String    @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_users")
}

model PlatformRole {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_roles")
}

model PlatformPermission {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(160)
  module      String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_permissions")
}

model PlatformRolePermission {
  id                   String   @id @default(cuid())
  platformRoleId       String
  platformPermissionId String
  createdAt            DateTime @default(now())

  @@unique([platformRoleId, platformPermissionId])
  @@index([platformRoleId])
  @@index([platformPermissionId])
  @@map("platform_role_permissions")
}

model User {
  id                 String         @id @default(cuid())
  tenantId           String
  email              String         @db.VarChar(255)
  username           String?        @db.VarChar(80)
  firstName          String         @db.VarChar(80)
  lastName           String         @db.VarChar(80)
  phone              String?        @db.VarChar(30)
  passwordHash       String         @db.VarChar(255)
  status             UserStatus     @default(INVITED)
  lastLoginAt        DateTime?
  mustChangePassword Boolean        @default(false)
  isMfaEnabled       Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles              UserRole[]
  sessions           Session[]
  refreshTokens      RefreshToken[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  code        String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  scope       RoleScope        @default(TENANT)
  isSystem    Boolean          @default(false)
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique @db.VarChar(160)
  module          String           @db.VarChar(80)
  action          String           @db.VarChar(80)
  screen          String?          @db.VarChar(80)
  description     String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  contextKey   String     @default("global") @db.VarChar(120)
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId, contextKey])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(500)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  code      String   @db.VarChar(80)
  name      String   @db.VarChar(120)
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tenant_modules")
}

model TenantModuleEntitlement {
  id               String   @id @default(cuid())
  tenantId         String
  moduleCode       String   @db.VarChar(80)
  entitlementKey   String   @db.VarChar(120)
  entitlementValue String   @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleCode, entitlementKey])
  @@index([tenantId])
  @@map("tenant_module_entitlements")
}

model TenantUsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  metricKey   String   @db.VarChar(120)
  metricValue Decimal  @default(0) @db.Decimal(18, 2)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, metricKey, periodStart, periodEnd])
  @@index([tenantId, metricKey])
  @@map("tenant_usage_counters")
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String    @db.VarChar(120)
  keyPrefix  String    @db.VarChar(20)
  keyHash    String    @unique @db.VarChar(255)
  scopes     Json?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_api_keys")
}

model TenantWebhook {
  id          String                  @id @default(cuid())
  tenantId    String
  eventKey    String                  @db.VarChar(120)
  endpointUrl String                  @db.VarChar(500)
  secretHash  String                  @db.VarChar(255)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries  TenantWebhookDelivery[]

  @@index([tenantId])
  @@map("tenant_webhooks")
}

model TenantWebhookDelivery {
  id           String        @id @default(cuid())
  tenantId     String
  webhookId    String
  eventId      String        @db.VarChar(120)
  statusCode   Int?
  success      Boolean       @default(false)
  requestBody  Json?
  responseBody Json?
  attemptedAt  DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  webhook      TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([webhookId])
  @@map("tenant_webhook_deliveries")
}

model AuditLog {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String?
  module     String        @db.VarChar(80)
  entityName String        @db.VarChar(120)
  entityId   String?       @db.VarChar(120)
  action     String        @db.VarChar(80)
  severity   SeverityLevel @default(INFO)
  ipAddress  String?       @db.VarChar(64)
  userAgent  String?       @db.VarChar(500)
  payload    Json?
  createdAt  DateTime      @default(now())
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String    @id @default(cuid())
  tenantId     String
  endpoint     String    @db.VarChar(255)
  requestKey   String    @db.VarChar(120)
  requestHash  String    @db.VarChar(255)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@unique([tenantId, endpoint, requestKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model TenantDomains {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_domains")
}

model TenantBrands {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_brands")
}

model TenantStatusHistory {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_status_history")
}

model TenantSettings {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_settings")
}

model TenantLocales {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_locales")
}

model TenantTimezones {
  id          String    @id @default(cuid())
  tenantId    String
  externalId  String?   @db.VarChar(191)
  code        String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(50)
  payload     Json?
  occurredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_timezones")
}

model TenantFeatureFlags {
  id          String    @id @default(cuid())
  tenantId    String
